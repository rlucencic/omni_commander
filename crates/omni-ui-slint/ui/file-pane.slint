// One file panel: location bar, column headers, virtualized rows, status.

import { LineEdit, ListView, Palette } from "std-widgets.slint";
import { EntryIcon, FileRow, MessageLevel, Metrics, PaneInfo, SortColumn } from "types.slint";

// Horizontal geometry shared by the header and every row. Cells are placed
// explicitly rather than with layouts: no per-row layout solving, and the
// visible columns can depend on the pane width without a binding loop.
struct Columns {
    name-x: length,
    name-width: length,
    ext-x: length,
    size-x: length,
    date-x: length,
    attr-x: length,
    show-date: bool,
    show-attributes: bool,
}

// Small vector icons, drawn with paths so they follow the theme and scale
// crisply at any DPI without image assets.
component EntryIconView inherits Rectangle {
    in property <EntryIcon> kind;

    property <bool> is-folder: root.kind == EntryIcon.folder || root.kind == EntryIcon.folder-link;
    property <bool> is-file: root.kind == EntryIcon.file || root.kind == EntryIcon.file-link || root.kind == EntryIcon.broken-link;
    property <bool> is-link: root.kind == EntryIcon.folder-link || root.kind == EntryIcon.file-link || root.kind == EntryIcon.broken-link;
    property <bool> dark: Palette.color-scheme == ColorScheme.dark;

    width: 16px;
    height: 16px;

    if root.is-folder: Path {
        width: 16px;
        height: 16px;
        viewbox-width: 16;
        viewbox-height: 16;
        commands: "M1.5 3.5 L6 3.5 L7.5 5 L14.5 5 L14.5 13.5 L1.5 13.5 Z";
        fill: root.dark ? #d9a441 : #e8b04a;
        stroke: root.dark ? #f0c86e : #b07d1e;
        stroke-width: 1px;
    }

    if root.is-file: Path {
        width: 16px;
        height: 16px;
        viewbox-width: 16;
        viewbox-height: 16;
        commands: "M3.5 1.5 L9.5 1.5 L12.5 4.5 L12.5 14.5 L3.5 14.5 Z";
        fill: root.dark ? #3b4048 : #ffffff;
        stroke: root.kind == EntryIcon.broken-link ? #d13438 : (root.dark ? #9aa3ad : #7a838c);
        stroke-width: 1px;
    }

    if root.is-file: Path {
        width: 16px;
        height: 16px;
        viewbox-width: 16;
        viewbox-height: 16;
        commands: "M9.5 1.5 L9.5 4.5 L12.5 4.5";
        stroke: root.dark ? #9aa3ad : #7a838c;
        stroke-width: 1px;
    }

    if root.kind == EntryIcon.parent: Path {
        width: 16px;
        height: 16px;
        viewbox-width: 16;
        viewbox-height: 16;
        commands: "M8 2 L13.5 7.5 L10 7.5 L10 14 L6 14 L6 7.5 L2.5 7.5 Z";
        fill: Palette.foreground;
        opacity: 0.7;
    }

    if root.kind == EntryIcon.other: Path {
        width: 16px;
        height: 16px;
        viewbox-width: 16;
        viewbox-height: 16;
        commands: "M8 2.5 L13.5 8 L8 13.5 L2.5 8 Z";
        fill: Palette.alternate-background;
        stroke: Palette.foreground;
        stroke-width: 1px;
    }

    // Link badge in the lower-left corner.
    if root.is-link: Rectangle {
        x: 0px;
        y: 8px;
        width: 8px;
        height: 8px;
        background: Palette.background;
        border-width: 1px;
        border-color: root.kind == EntryIcon.broken-link ? #d13438 : Palette.foreground;
        Path {
            width: 8px;
            height: 8px;
            viewbox-width: 8;
            viewbox-height: 8;
            commands: "M2 6 L6 2 M3.5 2 L6 2 L6 4.5";
            stroke: root.kind == EntryIcon.broken-link ? #d13438 : Palette.foreground;
            stroke-width: 1px;
        }
    }
}

component HeaderCell inherits Rectangle {
    in property <string> text;
    in property <bool> sortable: true;
    in property <bool> sorted;
    in property <bool> descending;
    in property <TextHorizontalAlignment> alignment: TextHorizontalAlignment.left;
    callback clicked;

    background: touch.has-hover && root.sortable ? Palette.control-background : transparent;

    touch := TouchArea {
        enabled: root.sortable;
        clicked => {
            root.clicked();
        }
    }

    HorizontalLayout {
        padding-left: Metrics.cell-padding;
        padding-right: Metrics.cell-padding;
        spacing: 4px;

        Text {
            text: root.text;
            horizontal-alignment: root.alignment;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
            font-weight: root.sorted ? 700 : 400;
            color: Palette.foreground;
        }

        if root.sorted: Rectangle {
            width: 8px;
            if root.descending: Path {
                width: 8px;
                height: 5px;
                viewbox-width: 8;
                viewbox-height: 5;
                commands: "M0 0 L8 0 L4 5 Z";
                fill: Palette.foreground;
            }
            if !root.descending: Path {
                width: 8px;
                height: 5px;
                viewbox-width: 8;
                viewbox-height: 5;
                commands: "M0 5 L4 0 L8 5 Z";
                fill: Palette.foreground;
            }
        }
    }
}

// A text cell with the same inner padding as HeaderCell, so columns align.
component Cell inherits Rectangle {
    in property <string> text;
    in property <TextHorizontalAlignment> alignment: TextHorizontalAlignment.left;
    in property <brush> foreground;
    in property <string> font-family;
    in property <bool> bold;

    Text {
        x: Metrics.cell-padding;
        width: parent.width - 2 * Metrics.cell-padding;
        height: parent.height;
        text: root.text;
        horizontal-alignment: root.alignment;
        vertical-alignment: center;
        overflow: elide;
        color: root.foreground;
        font-family: root.font-family;
        font-weight: root.bold ? 700 : 400;
    }
}

component FileRowView inherits Rectangle {
    in property <FileRow> data;
    in property <Columns> columns;
    in property <bool> current;
    in property <bool> pane-active;
    callback clicked;
    callback double-clicked;
    /// The mouse's back (false) or forward (true) button was pressed.
    callback history-button(forward: bool);
    /// The left button went down, with these modifiers.
    callback pressed(control: bool, shift: bool);
    callback middle-pressed;

    property <bool> highlighted: root.current && root.pane-active;
    property <color> marked-color: Palette.color-scheme == ColorScheme.dark ? #ff9e64 : #c2410c;
    property <brush> base-color: root.highlighted ? Palette.selection-foreground : (root.data.selected ? root.marked-color : Palette.foreground);
    property <brush> text-color: root.data.hidden ? root.base-color.transparentize(0.4) : root.base-color;

    height: Metrics.row-height;
    background: root.highlighted ? Palette.selection-background : (touch.has-hover ? Palette.alternate-background : transparent);
    // The inactive pane still shows where its cursor is.
    border-width: root.current && !root.pane-active ? 1px : 0px;
    border-color: Palette.selection-background;

    touch := TouchArea {
        clicked => {
            root.clicked();
        }
        double-clicked => {
            root.double-clicked();
        }
        pointer-event(event) => {
            if event.kind == PointerEventKind.down {
                if event.button == PointerEventButton.left {
                    root.pressed(event.modifiers.control, event.modifiers.shift);
                } else if event.button == PointerEventButton.middle {
                    root.middle-pressed();
                } else if event.button == PointerEventButton.back {
                    root.history-button(false);
                } else if event.button == PointerEventButton.forward {
                    root.history-button(true);
                }
            }
        }
    }

    // Selection marker.
    if root.data.selected: Rectangle {
        x: 0px;
        width: 3px;
        height: root.height;
        background: root.marked-color;
    }

    EntryIconView {
        x: root.columns.name-x + (Metrics.icon-column - 16px) / 2;
        y: (root.height - 16px) / 2;
        kind: root.data.icon;
        opacity: root.data.hidden ? 0.6 : 1.0;
    }

    Cell {
        x: root.columns.name-x + Metrics.icon-column - Metrics.cell-padding;
        width: max(0px, root.columns.name-width - Metrics.icon-column + Metrics.cell-padding);
        height: root.height;
        text: root.data.name;
        foreground: root.text-color;
        bold: root.data.selected;
    }

    Cell {
        x: root.columns.ext-x;
        width: Metrics.ext-column;
        height: root.height;
        text: root.data.ext;
        foreground: root.text-color;
    }

    Cell {
        x: root.columns.size-x;
        width: Metrics.size-column;
        height: root.height;
        text: root.data.size;
        alignment: right;
        foreground: root.text-color;
    }

    if root.columns.show-date: Cell {
        x: root.columns.date-x;
        width: Metrics.date-column;
        height: root.height;
        text: root.data.modified;
        foreground: root.text-color;
    }

    if root.columns.show-attributes: Cell {
        x: root.columns.attr-x;
        width: Metrics.attr-column;
        height: root.height;
        text: root.data.attributes;
        foreground: root.text-color;
        font-family: "monospace";
    }
}

// One tab: click selects, middle-click or × closes.
component TabButton inherits Rectangle {
    in property <string> title;
    /// The active tab of its pane.
    in property <bool> current;
    in property <bool> pane-active;
    callback select;
    callback close;

    background: root.current ? Palette.background : (touch.has-hover ? Palette.control-background : Palette.alternate-background);

    touch := TouchArea {
        clicked => {
            root.select();
        }
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.middle {
                root.close();
            }
        }
    }

    if root.current: Rectangle {
        y: 0px;
        height: 2px;
        background: root.pane-active ? Palette.accent-background : Palette.border;
    }

    Text {
        x: 10px;
        width: max(0px, parent.width - 34px);
        height: parent.height;
        text: root.title;
        overflow: elide;
        vertical-alignment: center;
        color: Palette.foreground;
        opacity: root.current ? 1.0 : 0.75;
        font-weight: root.current ? 600 : 400;
    }

    close-button := TouchArea {
        x: parent.width - 22px;
        y: (parent.height - 16px) / 2;
        width: 16px;
        height: 16px;
        clicked => {
            root.close();
        }
    }

    Rectangle {
        x: close-button.x;
        y: close-button.y;
        width: close-button.width;
        height: close-button.height;
        border-radius: 3px;
        background: close-button.has-hover ? Palette.foreground.transparentize(0.85) : transparent;
        Path {
            width: 16px;
            height: 16px;
            viewbox-width: 16;
            viewbox-height: 16;
            commands: "M5 5 L11 11 M11 5 L5 11";
            stroke: Palette.foreground;
            stroke-width: 1.2px;
            opacity: root.current || touch.has-hover || close-button.has-hover ? 0.8 : 0.0;
        }
    }

    // Separator to the next tab.
    Rectangle {
        x: parent.width - 1px;
        width: 1px;
        height: parent.height;
        background: Palette.border;
    }
}

// Back / forward / up button with a chevron icon.
component NavButton inherits Rectangle {
    /// 0 = back, 1 = forward, 2 = up.
    in property <int> direction;
    in property <bool> enabled;
    in property <brush> foreground;
    callback clicked;

    width: 24px;
    border-radius: 3px;
    background: touch.has-hover && root.enabled ? root.foreground.transparentize(0.85) : transparent;
    opacity: root.enabled ? 1.0 : 0.35;

    touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            root.clicked();
        }
    }

    if root.direction == 0: Path {
        x: (root.width - 14px) / 2;
        y: (root.height - 14px) / 2;
        width: 14px;
        height: 14px;
        viewbox-width: 14;
        viewbox-height: 14;
        commands: "M9 2.5 L4.5 7 L9 11.5";
        stroke: root.foreground;
        stroke-width: 1.5px;
    }
    if root.direction == 1: Path {
        x: (root.width - 14px) / 2;
        y: (root.height - 14px) / 2;
        width: 14px;
        height: 14px;
        viewbox-width: 14;
        viewbox-height: 14;
        commands: "M5 2.5 L9.5 7 L5 11.5";
        stroke: root.foreground;
        stroke-width: 1.5px;
    }
    if root.direction == 2: Path {
        x: (root.width - 14px) / 2;
        y: (root.height - 14px) / 2;
        width: 14px;
        height: 14px;
        viewbox-width: 14;
        viewbox-height: 14;
        commands: "M2.5 9 L7 4.5 L11.5 9";
        stroke: root.foreground;
        stroke-width: 1.5px;
    }
}

// One clickable path segment, followed by a separator unless it is the last.
component CrumbView inherits Rectangle {
    in property <string> text;
    in property <bool> last;
    in property <brush> foreground;
    callback clicked;

    border-radius: 3px;
    background: touch.has-hover ? root.foreground.transparentize(0.85) : transparent;

    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }

    HorizontalLayout {
        padding-left: 4px;
        padding-right: 4px;
        spacing: 5px;

        Text {
            text: root.text;
            color: root.foreground;
            vertical-alignment: center;
            font-weight: root.last ? 700 : 400;
        }

        if !root.last: Rectangle {
            width: 6px;
            Path {
                y: (parent.height - 10px) / 2;
                width: 6px;
                height: 10px;
                viewbox-width: 6;
                viewbox-height: 10;
                commands: "M1 1 L5 5 L1 9";
                stroke: root.foreground;
                stroke-width: 1px;
                opacity: 0.7;
            }
        }
    }
}

// Navigation buttons plus either breadcrumbs or a path editor.
component LocationBar inherits Rectangle {
    in property <PaneInfo> info;
    in property <bool> active;
    out property <bool> editing: false;

    /// Any click in the bar: the pane becomes active.
    callback activate;
    callback crumb-clicked(index: int);
    callback go-back;
    callback go-forward;
    callback go-up;
    callback location-entered(text: string);
    /// Editing ended (accepted or cancelled); keyboard focus should return
    /// to the file list.
    callback edit-finished;

    property <brush> foreground: root.active ? Palette.accent-foreground : Palette.foreground;

    public function edit() {
        root.editing = true;
        editor.text = root.info.location;
        editor.focus();
        editor.select-all();
    }

    function stop-editing() {
        if root.editing {
            root.editing = false;
            root.edit-finished();
        }
    }

    height: 30px;
    background: root.active ? Palette.accent-background : Palette.alternate-background;

    HorizontalLayout {
        padding: 3px;
        spacing: 1px;

        NavButton {
            direction: 0;
            enabled: root.info.can-go-back;
            foreground: root.foreground;
            clicked => {
                root.activate();
                root.go-back();
            }
        }

        NavButton {
            direction: 1;
            enabled: root.info.can-go-forward;
            foreground: root.foreground;
            clicked => {
                root.activate();
                root.go-forward();
            }
        }

        NavButton {
            direction: 2;
            enabled: root.info.crumbs.length > 1;
            foreground: root.foreground;
            clicked => {
                root.activate();
                root.go-up();
            }
        }

        Rectangle {
            horizontal-stretch: 1;
            clip: true;

            // Scrolled to the end, so long paths show their last segments.
            // The explicit size matters: without it, Slint forwards the
            // crumbs' preferred width to the Flickable and the pane would
            // grow with the path.
            crumbs-view := Flickable {
                width: parent.width;
                height: parent.height;
                visible: !root.editing;
                interactive: false;
                content-width: max(self.width, crumbs-row.preferred-width);
                content-x: min(0px, self.width - self.content-width);

                crumbs-row := HorizontalLayout {
                    width: crumbs-view.content-width;
                    height: crumbs-view.height;

                    for crumb[index] in root.info.crumbs: CrumbView {
                        text: crumb;
                        last: index == root.info.crumbs.length - 1;
                        foreground: root.foreground;
                        clicked => {
                            root.activate();
                            root.crumb-clicked(index);
                        }
                    }

                    // Clicking the empty space after the crumbs edits the path.
                    TouchArea {
                        horizontal-stretch: 1;
                        clicked => {
                            root.activate();
                            root.edit();
                        }
                    }
                }
            }

            FocusScope {
                width: parent.width;
                height: parent.height;
                visible: root.editing;
                // Keys the editor does not use (Tab, F-keys, arrows up/down)
                // must not trigger file-list shortcuts while typing.
                key-pressed(event) => {
                    accept
                }

                editor := LineEdit {
                    width: parent.width;
                    height: parent.height;
                    key-pressed(event) => {
                        if event.text == Key.Escape {
                            root.stop-editing();
                            return accept;
                        }
                        reject
                    }
                    accepted(text) => {
                        root.stop-editing();
                        root.location-entered(text);
                    }
                    changed has-focus => {
                        if !self.has-focus {
                            root.stop-editing();
                        }
                    }
                }
            }
        }
    }
}

export component FilePane inherits Rectangle {
    in property <[FileRow]> rows;
    in property <PaneInfo> info;
    in property <bool> active;
    out property <int> current-row: 0;

    callback cursor-changed(row: int);
    callback activated(row: int);
    callback clicked;
    callback sort-requested(column: SortColumn);
    callback crumb-clicked(index: int);
    callback go-back;
    callback go-forward;
    callback go-up;
    callback location-entered(text: string);
    callback edit-finished;
    callback row-pressed(row: int, control: bool, shift: bool);
    /// The quick filter text was edited.
    callback filter-edited(text: string);
    callback tab-selected(index: int);
    callback tab-closed(index: int);
    /// Middle-click on a row: open it in a background tab.
    callback open-in-new-tab(row: int);

    property <int> tab-count: root.info.tabs.length;
    // Tabs share the width (between 56 and 200 px each); like the columns,
    // they are placed explicitly so many tabs cannot widen the pane.
    property <length> tab-width: max(56px, min(200px, (root.width - 2px) / max(1, root.tab-count)));

    /// True while the filter editor has keyboard focus.
    out property <bool> filtering: false;
    property <bool> filter-shown: root.filtering || root.info.filter != "";

    public function edit-location() {
        location.edit();
    }

    /// Opens the quick filter, appending `typed` to the current filter text.
    public function start-filter(typed: string) {
        root.filtering = true;
        filter-editor.text = root.info.filter + typed;
        filter-editor.focus();
        if typed == "" {
            filter-editor.select-all();
        } else {
            // Caret to the end, so typing continues after the first letter.
            filter-editor.select-all();
            filter-editor.clear-selection();
            root.filter-edited(filter-editor.text);
        }
    }

    function stop-filtering() {
        if root.filtering {
            root.filtering = false;
            root.edit-finished();
        }
    }

    // Fixed-width columns are laid out from the right edge; the name column
    // takes what remains. Narrow panes drop the date and attribute columns.
    property <length> table-width: root.width - 2px;
    property <bool> show-date: root.table-width >= 460px;
    property <bool> show-attributes: root.table-width >= 620px;
    property <length> attr-x: root.table-width - 12px - (root.show-attributes ? Metrics.attr-column : 0px);
    property <length> date-x: root.attr-x - (root.show-date ? Metrics.date-column : 0px);
    property <length> size-x: root.date-x - Metrics.size-column;
    property <length> ext-x: root.size-x - Metrics.ext-column;
    property <Columns> columns: {
        name-x: 4px,
        name-width: max(0px, root.ext-x - 4px),
        ext-x: root.ext-x,
        size-x: root.size-x,
        date-x: root.date-x,
        attr-x: root.attr-x,
        show-date: root.show-date,
        show-attributes: root.show-attributes,
    };
    property <int> page-rows: max(1, floor(list.visible-height / Metrics.row-height) - 1);
    property <bool> dark: Palette.color-scheme == ColorScheme.dark;
    property <color> error-color: root.dark ? #ff7b72 : #c42b1c;
    property <color> warning-color: root.dark ? #e3b341 : #9a6700;

    /// Places the cursor after the rows were replaced.
    public function place-cursor(row: int, scroll-to-top: bool) {
        if scroll-to-top {
            list.content-y = 0;
        }
        root.set-cursor(row);
    }

    public function move-cursor(delta: int) {
        root.set-cursor(root.current-row + delta);
    }

    public function page-cursor(pages: int) {
        root.set-cursor(root.current-row + pages * root.page-rows);
    }

    function set-cursor(row: int) {
        root.current-row = max(0, min(row, root.rows.length - 1));
        root.ensure-visible(root.current-row);
        root.cursor-changed(root.current-row);
    }

    // Scrolls as little as possible to make `row` fully visible.
    // `content-y` is the (non-positive) offset of the rows in the viewport.
    function ensure-visible(row: int) {
        if row * Metrics.row-height < -list.content-y {
            list.content-y = -row * Metrics.row-height;
        } else if (row + 1) * Metrics.row-height > list.visible-height - list.content-y {
            list.content-y = list.visible-height - (row + 1) * Metrics.row-height;
        }
    }

    background: Palette.background;
    border-width: 1px;
    border-color: root.active ? Palette.accent-background : Palette.border;

    VerticalLayout {
        padding: 1px;

        if root.tab-count > 1: Rectangle {
            height: 28px;
            background: Palette.alternate-background;
            clip: true;

            for title[index] in root.info.tabs: TabButton {
                x: index * root.tab-width;
                width: root.tab-width;
                height: parent.height;
                title: title;
                current: index == root.info.active-tab;
                pane-active: root.active;
                select => {
                    root.clicked();
                    root.tab-selected(index);
                }
                close => {
                    root.clicked();
                    root.tab-closed(index);
                }
            }
        }

        location := LocationBar {
            info: root.info;
            active: root.active;
            activate => {
                root.clicked();
            }
            crumb-clicked(index) => {
                root.crumb-clicked(index);
            }
            go-back => {
                root.go-back();
            }
            go-forward => {
                root.go-forward();
            }
            go-up => {
                root.go-up();
            }
            location-entered(text) => {
                root.location-entered(text);
            }
            edit-finished => {
                root.edit-finished();
            }
        }

        // Column headers.
        Rectangle {
            height: Metrics.row-height + 2px;
            background: Palette.alternate-background;

            HeaderCell {
                x: root.columns.name-x;
                width: root.columns.name-width;
                text: "Name";
                sorted: root.info.sort-column == SortColumn.name;
                descending: root.info.sort-descending;
                clicked => {
                    root.sort-requested(SortColumn.name);
                }
            }

            HeaderCell {
                x: root.columns.ext-x;
                width: Metrics.ext-column;
                text: "Ext";
                sorted: root.info.sort-column == SortColumn.extension;
                descending: root.info.sort-descending;
                clicked => {
                    root.sort-requested(SortColumn.extension);
                }
            }

            HeaderCell {
                x: root.columns.size-x;
                width: Metrics.size-column;
                text: "Size";
                alignment: right;
                sorted: root.info.sort-column == SortColumn.size;
                descending: root.info.sort-descending;
                clicked => {
                    root.sort-requested(SortColumn.size);
                }
            }

            if root.show-date: HeaderCell {
                x: root.columns.date-x;
                width: Metrics.date-column;
                text: "Modified";
                sorted: root.info.sort-column == SortColumn.modified;
                descending: root.info.sort-descending;
                clicked => {
                    root.sort-requested(SortColumn.modified);
                }
            }

            if root.show-attributes: HeaderCell {
                x: root.columns.attr-x;
                width: Metrics.attr-column;
                text: "Attributes";
                sortable: false;
            }

            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: Palette.border;
            }
        }

        // Rows. ListView only instantiates the visible ones.
        list := ListView {
            for entry[index] in root.rows: FileRowView {
                data: entry;
                current: index == root.current-row;
                pane-active: root.active;
                columns: root.columns;
                clicked => {
                    root.clicked();
                    root.set-cursor(index);
                }
                double-clicked => {
                    root.activated(index);
                }
                pressed(control, shift) => {
                    root.row-pressed(index, control, shift);
                }
                middle-pressed => {
                    root.clicked();
                    root.open-in-new-tab(index);
                }
                history-button(forward) => {
                    root.clicked();
                    if forward {
                        root.go-forward();
                    } else {
                        root.go-back();
                    }
                }
            }
        }

        // Quick filter.
        Rectangle {
            height: root.filter-shown ? 28px : 0px;
            visible: root.filter-shown;
            background: Palette.alternate-background;

            HorizontalLayout {
                padding: 2px;
                padding-left: 8px;
                spacing: 6px;

                Text {
                    text: "Filter";
                    vertical-alignment: center;
                    color: Palette.foreground;
                    opacity: 0.8;
                }

                Rectangle {
                    horizontal-stretch: 1;

                // Not editing: show the active filter (it belongs to the
                // shown tab); a click edits it.
                Text {
                    visible: !root.filtering;
                    width: parent.width;
                    height: parent.height;
                    text: root.info.filter;
                    vertical-alignment: center;
                    overflow: elide;
                    color: Palette.foreground;
                }
                TouchArea {
                    visible: !root.filtering;
                    clicked => {
                        root.clicked();
                        root.start-filter("");
                    }
                }

                FocusScope {
                    visible: root.filtering;
                    width: parent.width;
                    height: parent.height;
                    // While typing, Up/Down/PgUp/PgDn move through the
                    // matches; other unused keys must not reach the list's
                    // shortcuts.
                    key-pressed(event) => {
                        if event.text == Key.UpArrow {
                            root.move-cursor(-1);
                        } else if event.text == Key.DownArrow {
                            root.move-cursor(1);
                        } else if event.text == Key.PageUp {
                            root.page-cursor(-1);
                        } else if event.text == Key.PageDown {
                            root.page-cursor(1);
                        } else if event.text == Key.Tab {
                            root.stop-filtering();
                        }
                        accept
                    }

                    filter-editor := LineEdit {
                        width: parent.width;
                        height: parent.height;
                        placeholder-text: "name, *.ext, a;b";
                        edited(text) => {
                            root.filter-edited(text);
                        }
                        // Enter opens what the cursor is on.
                        accepted(text) => {
                            root.stop-filtering();
                            root.activated(root.current-row);
                        }
                        key-pressed(event) => {
                            if event.text == Key.Escape {
                                self.text = "";
                                root.filter-edited("");
                                root.stop-filtering();
                                return accept;
                            }
                            reject
                        }
                        changed has-focus => {
                            if !self.has-focus {
                                root.stop-filtering();
                            }
                        }
                    }
                }
                }

                // Clear button for an active filter.
                if !root.filtering && root.info.filter != "": TouchArea {
                    width: 22px;
                    clicked => {
                        root.filter-edited("");
                    }
                    Path {
                        x: (parent.width - 16px) / 2;
                        y: (parent.height - 16px) / 2;
                        width: 16px;
                        height: 16px;
                        viewbox-width: 16;
                        viewbox-height: 16;
                        commands: "M5 5 L11 11 M11 5 L5 11";
                        stroke: Palette.foreground;
                        stroke-width: 1.2px;
                        opacity: parent.has-hover ? 1.0 : 0.6;
                    }
                }
            }
        }

        // Message line (errors, warnings, notices).
        if root.info.message != "": Rectangle {
            height: 22px;
            background: Palette.alternate-background;

            Text {
                x: 8px;
                width: parent.width - 16px;
                height: parent.height;
                text: root.info.message;
                vertical-alignment: center;
                overflow: elide;
                color: root.info.message-level == MessageLevel.error ? root.error-color : (root.info.message-level == MessageLevel.warning ? root.warning-color : Palette.foreground);
            }
        }

        // Status line.
        Rectangle {
            height: 22px;
            background: Palette.alternate-background;

            Text {
                x: 8px;
                width: parent.width - 16px;
                height: parent.height;
                text: root.info.loading != "" ? root.info.loading : (root.info.selection != "" ? root.info.selection : root.info.summary);
                vertical-alignment: center;
                overflow: elide;
                color: Palette.foreground;
                opacity: 0.8;
            }
        }
    }
}
